# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example as a template)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# python backend
backend/__pycache__/
backend/**/__pycache__/
backend/venv/
backend/.venv/
*.pyc
*.pyo

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars
backend.hcl

# pytest
.pytest_cache/

# deploy.sh state on the EC2 host
.last_good_tag
