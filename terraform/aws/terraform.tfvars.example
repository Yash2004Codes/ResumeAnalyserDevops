aws_region    = "us-east-1"
environment   = "production"
instance_type = "t3.micro"

github_repo = "Yash2004Codes/ResumeAnalyserDevops"
repo_url    = "https://github.com/Yash2004Codes/ResumeAnalyserDevops.git"
repo_branch = "master"

alert_email = "you@example.com"

# Set to false if your account already has the GitHub OIDC provider
create_github_oidc_provider = true

# ID-based OIDC subject prefix (from: gh api repos/<owner>/<repo>/actions/oidc/customization/sub)
github_repo_immutable_subject = "repo:<Owner>@<owner_id>/<Repo>@<repo_id>"
